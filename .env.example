# ============================================================
# OSIRIS API Authentication
# ============================================================
# REQUIRED: Set this to a strong secret to protect all /api/* routes
# Generate a secure key: openssl rand -hex 32
OSIRIS_API_KEY=your_secure_api_key_here

# ============================================================
# Optional Data Source API Keys
# ============================================================
# The platform works without these — most data sources are keyless
# AIS_API_KEY=your_aisstream_key       # Maritime vessel tracking (aisstream.io)
# OPENSKY_CLIENT_ID=                   # OpenSky OAuth2 — higher rate limits
# OPENSKY_CLIENT_SECRET=               # OpenSky OAuth2
